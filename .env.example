# Copy to .env.local and fill in. On Vercel, set the same names under
# Settings -> Environment Variables (all environments).

# OAuth client ID from Google Cloud -> APIs & Services -> Credentials
# (type: "Web application"). The two names hold the same value: the VITE_
# one is compiled into the login page, the other is read by the server.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Signing key for the session cookie. Generate a fresh one, never commit it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this value invalidates every live session.
AUTH_SECRET=

# Who is allowed into /admin. Comma-separated, case-insensitive.
# If BOTH are empty the gate fails closed and nobody gets in.
ADMIN_ALLOWED_EMAILS=you@example.com,teammate@example.com
ADMIN_ALLOWED_DOMAINS=
